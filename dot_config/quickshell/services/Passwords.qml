pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

// Bitwarden entries via rbw, for the launcher's passwords tab. Mirrors the old
// rofi-rbw setup: Enter copies the password (cleared from the clipboard after
// 30s if still there) and sends a notification; Shift+Enter copies the user.
// Any other field can be copied from an entry's field list (see openFields).
// Secret values are only ever fetched at copy time, straight into wl-copy.
Singleton {
    id: root

    // [{ id, name, user, folder }]
    property var entries: []
    property bool locked: false
    property bool loading: false

    readonly property int clearAfter: 30 // seconds

    // Field list of one entry: names from `rbw get --list-fields`, no values
    property var fieldsOf: null
    property var fields: []
    // Fields that aren't secret and stay on the clipboard
    readonly property var plainFields: ["username", "uris"]

    function openFields(e: var): void {
        fieldsOf = e;
        fields = [];
        fieldList.command = ["rbw", "get", "--list-fields", e.id];
        fieldList.running = true;
    }

    function closeFields(): void {
        fieldsOf = null;
        fields = [];
    }

    function searchFields(query: string, limit: int): var {
        const q = query.trim().toLowerCase();
        return fields.filter(f => q === "" || f.name.toLowerCase().includes(q)).slice(0, limit);
    }

    // Friendly label + preview for a field row
    function describe(f: var): var {
        switch (f.name) {
        case "username":
            return { title: "Username", hint: fieldsOf?.user ?? "" };
        case "password":
            return { title: "Password", hint: "••••••••" };
        case "totp":
            return { title: "One-time code (TOTP)", hint: "copies the current code" };
        case "uris":
            return { title: "URLs", hint: "" };
        case "notes":
            return { title: "Notes", hint: "" };
        default:
            return { title: f.name, hint: "custom field" };
        }
    }

    function copyField(e: var, name: string): void {
        // TOTP is generated by `rbw code`; everything else is `rbw get --field`
        const fetch = name === "totp" ? 'rbw code "$1"' : 'rbw get --field "$3" "$1"';
        const label = describe({ name }).title;
        const clear = plainFields.includes(name) ? "" : `
            sleep ${clearAfter}
            [ "$(wl-paste -n 2>/dev/null)" = "$v" ] && wl-copy --clear`;
        Quickshell.execDetached(["sh", "-c", `
            v=$(${fetch}) || exit 1
            printf %s "$v" | wl-copy
            notify-send -a Bitwarden -i dialog-password "Copied ${label.toLowerCase()}" "$2${clear ? ` — clears in ${clearAfter}s` : ""}"${clear}`, "sh", e.id, e.name, name]);
    }

    function refresh(): void {
        loading = true;
        unlockCheck.running = true;
    }

    function search(query: string, limit: int): var {
        if (locked)
            return [
                {
                    id: "",
                    name: "Unlock vault",
                    user: "",
                    folder: "rbw is locked — Enter to unlock",
                    unlock: true
                }
            ];
        const q = query.trim().toLowerCase();
        const hits = q === "" ? entries : entries.filter(e => e.name.toLowerCase().includes(q) || e.user.toLowerCase().includes(q) || e.folder.toLowerCase().includes(q));
        return hits.slice(0, limit);
    }

    function pick(e: var, alt: bool): void {
        if (e.unlock) {
            Quickshell.execDetached(["rbw", "unlock"]);
            return;
        }
        if (alt) {
            Quickshell.execDetached(["wl-copy", "--", e.user]);
            Quickshell.execDetached(["notify-send", "-a", "Bitwarden", "-i", "dialog-password", "Copied username", e.name]);
            return;
        }
        // Password goes from rbw straight into wl-copy; it never touches argv.
        Quickshell.execDetached(["sh", "-c", `
            pw=$(rbw get "$1") || exit 1
            printf %s "$pw" | wl-copy
            notify-send -a Bitwarden -i dialog-password "Copied password" "$2 — clears in ${clearAfter}s"
            sleep ${clearAfter}
            [ "$(wl-paste -n 2>/dev/null)" = "$pw" ] && wl-copy --clear`, "sh", e.id, e.name]);
    }

    Process {
        id: fieldList
        stdout: StdioCollector {
            onStreamFinished: {
                // Password first, then the rest in rbw's order
                const names = text.split("\n").filter(n => n !== "");
                root.fields = [...names.filter(n => n === "password"), ...names.filter(n => n !== "password")].map(name => ({
                            name
                        }));
            }
        }
    }

    Process {
        id: unlockCheck
        command: ["rbw", "unlocked"]
        onExited: code => {
            root.locked = code !== 0;
            if (root.locked)
                root.loading = false;
            else
                list.running = true;
        }
    }

    Process {
        id: list
        command: ["rbw", "list", "--fields", "id,name,user,folder"]
        stdout: StdioCollector {
            onStreamFinished: {
                root.entries = text.split("\n").filter(l => l !== "").map(l => {
                    const [id, name, user, folder] = l.split("\t");
                    return {
                        id,
                        name: name ?? "",
                        user: user ?? "",
                        folder: folder ?? ""
                    };
                }).sort((a, b) => a.name.localeCompare(b.name));
                root.loading = false;
            }
        }
    }
}
